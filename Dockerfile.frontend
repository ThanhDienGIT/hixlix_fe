# --- Giai đoạn 1: Sử dụng Node để build source code ---
FROM node:18-alpine AS builder
WORKDIR /app

# Sao chép file cấu hình package để tận dụng bộ nhớ cache của Docker
COPY package.json package-lock.json* yarn.lock* ./
RUN if [ -f yarn.lock ]; then yarn install --frozen-lockfile; else npm ci; fi

# Sao chép toàn bộ source code Frontend vào container
COPY . .
# Loại bỏ thư mục Backend (BE) khỏi quá trình build Frontend để giảm dung lượng
RUN rm -rf BE

# Thực hiện build mã nguồn ReactJS ra các file tĩnh nằm trong thư mục /app/build
RUN npm run build

# --- Giai đoạn 2: Sử dụng Nginx Production để serve file tĩnh ---
FROM nginx:stable-alpine
# Copy toàn bộ file tĩnh đã build từ Giai đoạn 1 sang thư mục root của Nginx
COPY --from=builder /app/build /usr/share/nginx/html

# Cấu hình Nginx tối ưu cho React Router (Tránh lỗi 404 khi người dùng reload trang)
RUN echo 'server { \
    listen 80; \
    location / { \
        root /usr/share/nginx/html; \
        index index.html index.htm; \
        try_files $uri $uri/ /index.html; \
    } \
}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]